      "type": "timeseries",
      "title": "Volumen del estanque (últimas 24 h)",
      "description": "Evolución temporal del volumen del equipo E31 / P15 / nodo1.",
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUXDB}"
      },
      "gridPos": {
        "h": 9,
        "w": 16,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "liters",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"mediciones\")\n  |> range(start: -24h)\n  |> filter(fn: (r) => r._measurement == \"mediciones\")\n  |> filter(fn: (r) => r.equipo == \"E31\" and r.proyecto == \"P15\" and r.nodo == \"nodo1\")\n  |> filter(fn: (r) => r._field == \"volumen_l\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)",
          "language": "flux"
        }
      ]
    },
    {
